# Copia este archivo a .env y reemplaza los valores de ejemplo localmente.
# Compose establece DB_URL=jdbc:postgresql://db:5432/BD_AliviaTech.
DB_USER=aliviatech
DB_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
DDL_AUTO=update
ALIVIATECH_JWT_EXPIRATION_MS=1200000
ALIVIATECH_FRONTEND_ACTIVACION_URL=http://localhost:4200/activar-cuenta
ALIVIATECH_CONSENTIMIENTO_VERSION=1.0
ALIVIATECH_TERMINOS_URL=http://localhost:4200/terminos
ALIVIATECH_MAIL_ENABLED=true
ALIVIATECH_MAIL_FROM=
ALIVIATECH_SMTP_HOST=smtp.gmail.com
ALIVIATECH_SMTP_PORT=587
ALIVIATECH_SMTP_USERNAME=
ALIVIATECH_SMTP_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ALIVIATECH_WEARABLE_SIMULATOR_ENABLED=true
ALIVIATECH_WEARABLE_READINGS_CRON=0 */15 * * * *
ALIVIATECH_WEARABLE_SUMMARIES_CRON=0 5 0 * * *
